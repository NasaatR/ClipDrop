<Window x:Class="ClipDrop.Windows.MainWindow"
 xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:ClipDrop.Windows.Views"
 Title="ClipDrop Library" Width="376" Height="500" MinWidth="320" MinHeight="300" WindowStyle="None" ResizeMode="CanResizeWithGrip"
 ShowInTaskbar="False" AllowDrop="True" UseLayoutRounding="True" PreviewKeyDown="OnKey" DragOver="OnDragOver" Drop="OnDrop">
 <Window.Resources>
  <Style x:Key="ClipSelector" TargetType="primitives:ToggleButton">
   <Setter Property="Width" Value="20"/><Setter Property="Height" Value="24"/><Setter Property="Margin" Value="0,0,7,0"/><Setter Property="Focusable" Value="True"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="primitives:ToggleButton"><Grid Background="Transparent"><Border x:Name="Box" Width="16" Height="16" BorderBrush="{DynamicResource Muted}" BorderThickness="1" CornerRadius="4" VerticalAlignment="Center"><TextBlock x:Name="Tick" Text="✓" FontSize="12" Foreground="{DynamicResource Ink}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Border></Grid><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource Selected}"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Ink}"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Box" Property="BorderThickness" Value="2"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Window.ContextMenu><ContextMenu FontSize="11.5">
  <MenuItem Header="Save clipboard to Library" Click="OnPaste" Padding="6,3"/>
  <MenuItem Header="Add files…" Click="OnAddFiles" Padding="6,3"/>
  <MenuItem Header="Saved panels" Click="OnPanels" Padding="6,3"/>
  <MenuItem Header="Select all" Click="OnSelectAll" Padding="6,3"/>
  <Separator/>
  <MenuItem x:Name="AttachOption" Header="Follow dock" IsCheckable="True" Click="OnAttach" Padding="6,3"/>
  <MenuItem x:Name="TopOption" Header="Always on top" IsCheckable="True" Click="OnToggleTop" Padding="6,3"/>
  <MenuItem Header="Settings" Click="OnSettings" Padding="6,3"/>
  <MenuItem x:Name="ClearOption" Header="Clear clips outside saved panels" Click="OnClear" Padding="6,3"/>
  <Separator/><MenuItem Header="Quit ClipDrop" Click="OnQuit" Padding="6,3"/>
 </ContextMenu></Window.ContextMenu>
 <Border x:Name="LibrarySurface" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Background="{DynamicResource Surface}" Margin="12,0,8,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="Library" FontWeight="SemiBold" FontSize="15"/><TextBlock x:Name="CountLabel" Margin="8,2,0,0" Foreground="{DynamicResource Muted}"/></StackPanel>
   <Button Grid.Column="1" Content="Panels" Click="OnPanels" FontSize="12" Padding="8,5" Background="Transparent" ToolTip="Saved panels · save the current selection as a set" AutomationProperties.Name="Saved panels"/>
   <Button Grid.Column="2" Content="More" Click="OnLibraryMenu" FontSize="12" Padding="8,5" Background="Transparent" ToolTip="Library options" AutomationProperties.Name="Library options"/>
   <Button Grid.Column="3" Style="{StaticResource IconButton}" Click="OnHide" ToolTip="Hide Library" AutomationProperties.Name="Hide Library"><views:AppIcon Kind="Close" Width="16" Height="16"/></Button>
  </Grid>
  <DockPanel Grid.Row="1" Margin="10,0,10,8" LastChildFill="True">
   <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="OnPaste" ToolTip="Save clipboard directly to Library · Ctrl+V" AutomationProperties.Name="Save clipboard"><views:AppIcon Kind="Save" /></Button>
   <Button DockPanel.Dock="Right" Content="Add files" Click="OnAddFiles" FontSize="12" Padding="8,5" ToolTip="Add files directly to Library · Ctrl+O" AutomationProperties.Name="Add files"/>
   <Grid Margin="2">
    <TextBox x:Name="SearchBox" TextChanged="OnSearch" VerticalContentAlignment="Center" ToolTip="Search shelf · Ctrl+F" AutomationProperties.Name="Search shelf"/>
    <TextBlock Text="Search" Foreground="{DynamicResource Muted}" Margin="9,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
   </Grid>
  </DockPanel>
  <DockPanel Grid.Row="2" Margin="10,0,10,8" LastChildFill="True">
   <Button x:Name="AllFilter" Content="All" Tag="All" Click="OnFilter" Padding="8,4" FontSize="12"/>
   <Button x:Name="PinnedFilter" Content="Pinned" Tag="Pinned" Click="OnFilter" Padding="8,4" FontSize="12"/>
   <Button x:Name="TrashFilter" Content="Trash" Tag="Trash" Click="OnFilter" Padding="8,4" FontSize="12"/>
   <ComboBox x:Name="GroupFilter" Margin="5,2,2,2" SelectionChanged="OnGroupFilter" ToolTip="Filter by group" AutomationProperties.Name="Group filter"/>
  </DockPanel>
  <Grid Grid.Row="3" Margin="12,0,12,4">
   <ListBox x:Name="ItemList" SelectionMode="Extended" PreviewMouseLeftButtonDown="OnItemDown" PreviewMouseLeftButtonUp="OnItemUp" PreviewMouseMove="OnItemMove" SelectionChanged="OnSelection" MouseDoubleClick="OnOpen" PreviewMouseRightButtonDown="OnItemRightDown" ContextMenuOpening="OnClipMenu"
    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" AutomationProperties.Name="Shelf items">
    <ListBox.ContextMenu><ContextMenu/></ListBox.ContextMenu>
    <ListBox.ItemTemplate><DataTemplate><Grid ToolTip="{Binding Help}">
     <Grid.ColumnDefinitions><ColumnDefinition Width="27"/><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <primitives:ToggleButton Style="{StaticResource ClipSelector}" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}" ToolTip="Select this clip · select several to drag together" AutomationProperties.Name="{Binding SelectName}"/>
     <Image Grid.Column="1" x:Name="Thumbnail" Width="32" Height="32" Stretch="Uniform" Visibility="{Binding ImageVisible}" Loaded="OnThumbnailLoaded" DataContextChanged="OnThumbnailContext"/>
     <views:AppIcon Grid.Column="1" Kind="{Binding IconKey}" Width="24" Height="24"><views:AppIcon.Style><Style TargetType="views:AppIcon"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=Thumbnail}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></views:AppIcon.Style></views:AppIcon>
     <StackPanel Grid.Column="2" Margin="7,0,4,0"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxHeight="24"/><TextBlock Text="{Binding Details}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
     <views:AppIcon Kind="Pin" Grid.Column="3" Width="14" Height="16" Visibility="{Binding Pinned}"/>
    </Grid></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="12">
    <views:AppIcon Kind="Save" Width="38" Height="38" Margin="0,0,0,14"/>
    <TextBlock x:Name="EmptyTitle" Text="Drop something here" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
    <TextBlock Text="Files, images, links and text" Foreground="{DynamicResource Muted}" Margin="0,7,0,0" HorizontalAlignment="Center"/>
    <TextBlock Text="or paste with Ctrl+V" Foreground="{DynamicResource Muted}" Margin="0,5,0,0" HorizontalAlignment="Center"/>
   </StackPanel>
   <Border x:Name="DropCue" Visibility="Collapsed" Background="{DynamicResource Selected}" BorderBrush="{DynamicResource Ink}" BorderThickness="1" CornerRadius="6" IsHitTestVisible="False" Opacity="0.95"><TextBlock Text="Save to Library" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/></Border>
  </Grid>
  <Border x:Name="EditPanel" Grid.Row="4" Visibility="Collapsed" Background="{DynamicResource Raised}" CornerRadius="8" Padding="10" Margin="12,0,12,8"><StackPanel>
   <TextBlock Text="Name" FontSize="11" Margin="0,0,0,4"/><TextBox x:Name="NameEditor" MaxLength="120" AutomationProperties.Name="Item name"/>
   <TextBlock Text="Group" FontSize="11" Margin="0,7,0,4"/><TextBox x:Name="GroupEditor" MaxLength="40" AutomationProperties.Name="Item group"/>
   <StackPanel Orientation="Horizontal" Margin="0,7,0,0"><Button Content="Save" Click="OnSaveEdit"/><Button Content="Cancel" Click="OnCancelEdit"/></StackPanel>
  </StackPanel></Border>
  <DockPanel Grid.Row="5" Margin="10,2,10,6">
   <Button x:Name="RestoreButton" Content="Restore selected" Click="OnRestore" Visibility="Collapsed" ToolTip="Restore selection from Trash"/>
   <WrapPanel x:Name="ActiveActions" Visibility="Collapsed">
    <Button x:Name="DragSelectedButton" Content="Drag selected" PreviewMouseLeftButtonDown="OnBatchDown" PreviewMouseMove="OnBatchMove" PreviewMouseLeftButtonUp="OnBatchUp" Click="OnDragHint" ToolTip="Drag this button or any selected row to transfer the whole selection" AutomationProperties.Name="Drag selected clips" Cursor="Hand" Background="{DynamicResource Selected}"/>
    <Button x:Name="PasteButton" Content="Paste" Click="OnPasteSelected" ToolTip="Paste selected into previous app · Enter" AutomationProperties.Name="Paste selection"/>
    <Button x:Name="SelectionMoreButton" Content="More" Click="OnSelectionMenu" ToolTip="Copy, keep, delete and other selection actions" AutomationProperties.Name="Selection actions"/>
   </WrapPanel>
  </DockPanel>
  <Grid Grid.Row="6" Margin="14,0,14,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="StatusLabel" Text="Ready" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite"/>
   <TextBlock Grid.Column="1" Text="Ctrl+Alt+L" Foreground="{DynamicResource Muted}" FontSize="11" Margin="8,0,0,0"/>
  </Grid>
 </Grid></Border>
</Window>
