<Window x:Class="ClipDrop.Windows.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ClipDrop" Width="376" Height="500" MinWidth="320" MinHeight="300" WindowStyle="None" ResizeMode="CanResizeWithGrip"
 ShowInTaskbar="False" AllowDrop="True" UseLayoutRounding="True" PreviewKeyDown="OnKey" DragOver="OnDragOver" Drop="OnDrop">
 <Window.ContextMenu><ContextMenu>
  <MenuItem Header="Paste into shelf" Click="OnPaste"/>
  <MenuItem Header="Add files…" Click="OnAddFiles"/>
  <Separator/><MenuItem Header="Copy selected" Click="OnCopy"/>
  <MenuItem Header="Copy as plain text" Click="OnCopyText"/>
  <MenuItem Header="Pin / unpin selected" Click="OnPin"/>
  <MenuItem Header="Remove selected" Click="OnRemove"/>
  <Separator/><MenuItem Header="Settings" Click="OnSettings"/>
  <MenuItem Header="Quit ClipDrop" Click="OnQuit"/>
 </ContextMenu></Window.ContextMenu>
 <Border BorderBrush="{DynamicResource Stroke}" BorderThickness="1">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Background="{DynamicResource Surface}" MouseLeftButtonDown="OnTitleDrag" Margin="12,0,8,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="ClipDrop" FontWeight="SemiBold" FontSize="15"/><TextBlock x:Name="CountLabel" Margin="8,2,0,0" Foreground="{DynamicResource Muted}"/></StackPanel>
   <Button Grid.Column="1" Click="OnToggleTop" ToolTip="Keep above other windows" AutomationProperties.Name="Toggle always on top" Padding="7"><Path x:Name="TopIcon" Stroke="{DynamicResource Ink}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Data="M3,1 L11,1 M5,1 L5,6 L2,9 L12,9 L9,6 L9,1 M7,9 L7,14"/></Button>
   <Button Grid.Column="2" Click="OnSettings" ToolTip="Settings" AutomationProperties.Name="Settings" Padding="7"><Path Stroke="{DynamicResource Ink}" StrokeThickness="1.5" Width="14" Height="14" Stretch="Uniform" Data="M1,3 L13,3 M1,7 L13,7 M1,11 L13,11 M4,1 L4,5 M10,5 L10,9 M6,9 L6,13"/></Button>
   <Button Grid.Column="3" Click="OnHide" ToolTip="Hide to tray · Ctrl+Alt+Space" AutomationProperties.Name="Hide shelf" Padding="7"><Path Stroke="{DynamicResource Ink}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" Data="M1,1 L11,11 M11,1 L1,11"/></Button>
  </Grid>
  <DockPanel Grid.Row="1" Margin="10,0,10,8" LastChildFill="True">
   <Button DockPanel.Dock="Right" Content="Paste" Click="OnPaste" ToolTip="Paste into shelf · Ctrl+V"/>
   <Button DockPanel.Dock="Right" Click="OnAddFiles" ToolTip="Add files · Ctrl+O" AutomationProperties.Name="Add files" Padding="8"><Path Stroke="{DynamicResource Ink}" StrokeThickness="1.5" Width="12" Height="12" Stretch="Uniform" Data="M6,0 L6,12 M0,6 L12,6"/></Button>
   <TextBox x:Name="SearchBox" TextChanged="OnSearch" VerticalContentAlignment="Center" ToolTip="Search shelf · Ctrl+F" AutomationProperties.Name="Search shelf" Margin="2"/>
  </DockPanel>
  <Grid Grid.Row="2" Margin="12,0,12,4">
   <ListBox x:Name="ItemList" SelectionMode="Extended" PreviewMouseLeftButtonDown="OnItemDown" PreviewMouseLeftButtonUp="OnItemUp" PreviewMouseMove="OnItemMove" SelectionChanged="OnSelection" MouseDoubleClick="OnOpen"
    VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" ScrollViewer.CanContentScroll="True" AutomationProperties.Name="Shelf items">
    <ListBox.ItemTemplate><DataTemplate><Grid ToolTip="{Binding Help}">
     <Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Image Width="28" Height="28" Stretch="Uniform" Visibility="{Binding ImageVisible}" Loaded="OnThumbnailLoaded"/>
     <Path Width="19" Height="24" Stretch="Uniform" HorizontalAlignment="Center" Stroke="{DynamicResource Muted}" StrokeThickness="1.4" Visibility="{Binding IconVisible}" Data="M1,1 L11,1 L17,7 L17,23 L1,23 Z M11,1 L11,7 L17,7"/>
     <StackPanel Grid.Column="1" Margin="7,0,4,0"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" MaxHeight="24"/><TextBlock Text="{Binding Details}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
     <Path Grid.Column="2" Width="10" Height="12" Stretch="Uniform" Stroke="{DynamicResource Muted}" StrokeThickness="1.4" Visibility="{Binding Pinned}" Data="M1,1 L9,1 M3,1 L3,5 L1,8 L9,8 L7,5 L7,1 M5,8 L5,12"/>
    </Grid></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="12">
    <Path Stroke="{DynamicResource Muted}" StrokeThickness="1.4" Width="38" Height="38" Stretch="Uniform" Data="M3,22 L3,35 L35,35 L35,22 M19,1 L19,26 M10,17 L19,26 L28,17" Margin="0,0,0,14"/>
    <TextBlock x:Name="EmptyTitle" Text="Drop something here" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center"/>
    <TextBlock Text="Files, images, links and text" Foreground="{DynamicResource Muted}" Margin="0,7,0,0" HorizontalAlignment="Center"/>
    <TextBlock Text="or paste with Ctrl+V" Foreground="{DynamicResource Muted}" Margin="0,5,0,0" HorizontalAlignment="Center"/>
   </StackPanel>
   <Border x:Name="DropCue" Visibility="Collapsed" Background="{DynamicResource Selected}" BorderBrush="{DynamicResource Ink}" BorderThickness="1" CornerRadius="6" IsHitTestVisible="False" Opacity="0.95"><TextBlock Text="Add to shelf" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="18"/></Border>
  </Grid>
  <DockPanel Grid.Row="3" Margin="10,2,10,6">
   <Button DockPanel.Dock="Right" Content="Clear" Click="OnClear" ToolTip="Remove unpinned cards; originals are preserved"/>
   <StackPanel Orientation="Horizontal"><Button x:Name="CopyButton" Content="Copy" Click="OnCopy" ToolTip="Copy selection · Ctrl+C"/><Button x:Name="PinButton" Content="Pin" Click="OnPin"/><Button x:Name="RemoveButton" Content="Remove" Click="OnRemove" ToolTip="Remove cards · Delete"/></StackPanel>
  </DockPanel>
  <Grid Grid.Row="4" Margin="14,0,14,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <TextBlock x:Name="StatusLabel" Text="Ready" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" AutomationProperties.LiveSetting="Polite"/>
   <TextBlock Grid.Column="1" Text="Ctrl+Alt+Space" Foreground="{DynamicResource Muted}" FontSize="11" Margin="8,0,0,0"/>
  </Grid>
 </Grid></Border>
</Window>
