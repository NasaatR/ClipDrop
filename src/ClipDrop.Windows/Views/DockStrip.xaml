<UserControl x:Class="ClipDrop.Windows.Views.DockStrip" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Focusable="False" UseLayoutRounding="True" Background="#01000000">
 <UserControl.Resources>
  <Style x:Key="DockButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Width" Value="{DynamicResource DockSize}"/><Setter Property="Height" Value="{DynamicResource DockSize}"/><Setter Property="MinHeight" Value="0"/><Setter Property="Margin" Value="{DynamicResource DockGap}"/><Setter Property="Padding" Value="0"/><Setter Property="Focusable" Value="False"/>
  </Style>
 </UserControl.Resources>
 <Border x:Name="Body" Margin="10" Background="{DynamicResource DockBackground}" BorderBrush="{DynamicResource DockOutline}" BorderThickness="1" CornerRadius="{DynamicResource DockRadius}" Padding="12,8" ToolTipService.InitialShowDelay="600">
  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
   <TextBlock Text="⠿" Width="18" FontSize="18" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" ToolTip="Drag any empty area to move"/>
   <Button x:Name="SaveButton" Style="{StaticResource DockButton}" Click="OnSave" ToolTip="Save clipboard" AutomationProperties.Name="Save clipboard" Background="{DynamicResource Accent}" Tag="primary"><Image Source="{StaticResource SaveArtwork}" Width="21" Height="21"/></Button>
   <Button x:Name="SettingsButton" Style="{StaticResource DockButton}" Click="OnSettings" ToolTip="Settings" AutomationProperties.Name="Settings"><Image Source="{StaticResource GearArtwork}" Width="20" Height="20"/></Button>
   <Button x:Name="LibraryButton" Style="{StaticResource DockButton}" Click="OnLibrary" ToolTip="Library · Ctrl+Alt+L" AutomationProperties.Name="Open Library"><Path Style="{StaticResource LineIcon}" Data="{StaticResource LibraryIcon}"/></Button>
   <Border Width="1" Background="{DynamicResource DockOutline}" Margin="6,7"/>
   <TextBlock x:Name="EmptyHint" Text="Drop here" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="8,0" FontSize="11" IsHitTestVisible="False"/>
   <ItemsControl x:Name="PinnedItems"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate>
     <Button Style="{StaticResource DockButton}" ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title}" Click="OnPin" PreviewMouseLeftButtonDown="OnPinDown" PreviewMouseLeftButtonUp="OnPinUp" PreviewMouseMove="OnPinMove" Loaded="OnPinLoaded">
      <Grid><Image Width="24" Height="24" Stretch="Uniform" Visibility="{Binding ImageVisible}" Loaded="OnImageLoaded"/><TextBlock Text="{Binding DockGlyph}" Visibility="{Binding IconVisible}" FontFamily="Segoe UI Emoji" FontSize="18" LineHeight="22" TextAlignment="Center" VerticalAlignment="Center"/></Grid>
     </Button>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
   <Button x:Name="OverflowButton" Style="{StaticResource DockButton}" Click="OnLibrary" ToolTip="More pins in Library" AutomationProperties.Name="Show more pinned items" Visibility="Collapsed"/>
  </StackPanel>
 </Border>
</UserControl>
