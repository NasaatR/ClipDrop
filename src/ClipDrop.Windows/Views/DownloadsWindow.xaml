<Window x:Class="ClipDrop.Windows.Views.DownloadsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:ClipDrop.Windows.Views"
 Title="ClipDrop Downloads" Width="344" Height="508" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False" Focusable="False" UseLayoutRounding="True" PreviewKeyDown="OnKey">
 <Window.ContextMenu><ContextMenu/></Window.ContextMenu>
 <Grid x:Name="Stage" Background="{x:Null}">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="62"/></Grid.RowDefinitions>
  <Border x:Name="Details" VerticalAlignment="Bottom" Margin="10,10,10,3" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="8">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="3,0,0,5">
     <Button DockPanel.Dock="Right" Content="Close" Click="OnDismiss" FontSize="10.5" Padding="6,3" MinHeight="24" Margin="4,0,0,0" ToolTip="Close the list · hover the capsule to reopen"/>
     <TextBlock x:Name="Count" DockPanel.Dock="Right" Foreground="{DynamicResource Muted}" FontSize="10.5" VerticalAlignment="Center" Margin="8,0,5,0"/>
     <TextBlock Text="Downloads" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" ToolTip="Drag any row · Ctrl/Shift to select a group · right-click for actions"/>
    </DockPanel>
    <StackPanel x:Name="Notice" Grid.Row="1" Margin="3,2,3,7" Visibility="Collapsed">
     <TextBlock x:Name="Summary" Foreground="{DynamicResource Muted}" Text="Loading recent files…" FontSize="11" TextWrapping="Wrap"/>
     <Button x:Name="SourceButton" Content="Connect Chrome" Click="OnSource" HorizontalAlignment="Left" FontSize="11" Padding="7,4" MinHeight="26" Margin="0,5,0,0" Visibility="Collapsed"/>
    </StackPanel>
    <ListBox x:Name="Files" Grid.Row="2" SelectionMode="Extended" SelectionChanged="OnSelection" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel" AutomationProperties.Name="Recent downloaded files" PreviewMouseLeftButtonDown="OnRowDown" PreviewMouseMove="OnRowMove" PreviewMouseLeftButtonUp="OnRowUp" PreviewMouseRightButtonUp="OnRowMenu">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Height" Value="34"/><Setter Property="Padding" Value="5,4"/><Setter Property="Margin" Value="0"/><Setter Property="AutomationProperties.Name" Value="{Binding File.Name}"/></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate>
      <Grid ToolTip="{Binding Details}"><Grid.ColumnDefinitions><ColumnDefinition Width="31"/><ColumnDefinition Width="*"/><ColumnDefinition Width="47"/></Grid.ColumnDefinitions>
       <Grid Width="24" Height="24" HorizontalAlignment="Left">
        <views:AppIcon Kind="{Binding RowItem.IconKey}" Width="22" Height="22"><views:AppIcon.Style><Style TargetType="views:AppIcon"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=Thumbnail}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></views:AppIcon.Style></views:AppIcon>
        <Image x:Name="Thumbnail" Stretch="Uniform" Visibility="{Binding RowItem.ImageVisible}" Loaded="OnThumbnail" DataContextChanged="OnThumbnailContext"/>
       </Grid>
       <TextBlock Grid.Column="1" Text="{Binding File.Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12"/>
       <TextBlock Grid.Column="2" Text="{Binding Time}" Foreground="{DynamicResource Muted}" FontSize="10" TextAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,0"/>
      </Grid>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
   </Grid>
  </Border>
  <Border x:Name="HoverBridge" Grid.Row="1" Width="52" HorizontalAlignment="Right" Margin="10,0,10,10" Background="#01000000"/>
  <Border x:Name="CapsuleShell" Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="8,5">
   <Button x:Name="Capsule" Width="34" Height="30" MinHeight="0" Padding="0" Margin="0" Focusable="False" Click="OnCapsule" ToolTip="Downloads · hover to reveal · click to open · drag the edge to move · right-click for options" AutomationProperties.Name="Downloads stack"><views:AppIcon Kind="Downloads" Width="23" Height="23"/></Button>
  </Border>
 </Grid>
</Window>
