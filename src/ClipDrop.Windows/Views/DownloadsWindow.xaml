<Window x:Class="ClipDrop.Windows.Views.DownloadsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework" xmlns:views="clr-namespace:ClipDrop.Windows.Views"
 Title="ClipDrop Downloads" Width="344" Height="456" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" ShowActivated="False" Focusable="False" UseLayoutRounding="True" PreviewKeyDown="OnKey">
 <Window.ContextMenu><ContextMenu/></Window.ContextMenu>
 <Grid x:Name="Stage" Background="{x:Null}" Margin="0">
  <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="62"/></Grid.RowDefinitions>
  <Border x:Name="Details" VerticalAlignment="Bottom" Margin="10,10,10,3" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="10">
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <DockPanel Margin="2,0,0,7"><Button DockPanel.Dock="Right" Content="Open folder" Click="OnFolder" FontSize="11" Padding="7,4" MinHeight="26" ToolTip="Open the watched folder in Explorer"/><TextBlock Text="Downloads" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/></DockPanel>
    <TextBlock x:Name="Summary" Grid.Row="1" Foreground="{DynamicResource Muted}" Text="Loading recent files…" FontSize="11" TextWrapping="Wrap" Margin="2,0,2,7"/>
    <ListBox x:Name="Files" Grid.Row="2" SelectionMode="Extended" SelectionChanged="OnSelection" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Recent downloaded files" PreviewMouseLeftButtonDown="OnRowDown" PreviewMouseMove="OnRowMove" PreviewMouseLeftButtonUp="OnRowUp" PreviewMouseRightButtonUp="OnRowMenu">
     <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="4,5"/><Setter Property="Margin" Value="0,1"/></Style></ListBox.ItemContainerStyle>
     <ListBox.ItemTemplate><DataTemplate>
      <Grid ToolTip="{Binding File.Path}"><Grid.ColumnDefinitions><ColumnDefinition Width="27"/><ColumnDefinition Width="36"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <primitives:ToggleButton Style="{StaticResource ClipSelector}" IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}" VerticalAlignment="Center" AutomationProperties.Name="{Binding SelectName}"/>
       <Grid Grid.Column="1" Width="28" Height="28" HorizontalAlignment="Left">
        <views:AppIcon Kind="{Binding RowItem.IconKey}" Width="25" Height="25"><views:AppIcon.Style><Style TargetType="views:AppIcon"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=Thumbnail}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></views:AppIcon.Style></views:AppIcon>
        <Image x:Name="Thumbnail" Stretch="Uniform" Visibility="{Binding RowItem.ImageVisible}" Loaded="OnThumbnail" DataContextChanged="OnThumbnailContext"/>
       </Grid>
       <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding File.Name}" TextTrimming="CharacterEllipsis" FontSize="12"/><TextBlock Text="{Binding Description}" Foreground="{DynamicResource Muted}" FontSize="10.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
      </Grid>
     </DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <WrapPanel x:Name="Actions" Grid.Row="3" Margin="0,6,0,0" Visibility="Collapsed">
     <Button x:Name="DragSelection" Content="Drag files" Click="OnDragHint" FontSize="11" Padding="7,4" MinHeight="26" PreviewMouseLeftButtonDown="OnActionDown" PreviewMouseMove="OnRowMove" PreviewMouseLeftButtonUp="OnRowUp" ToolTip="Drag the selected files to another app"/>
     <Button Content="Copy" Click="OnCopy" FontSize="11" Padding="7,4" MinHeight="26"/>
     <Button Content="Save to Library" Click="OnSave" FontSize="11" Padding="7,4" MinHeight="26"/>
    </WrapPanel>
   </Grid>
  </Border>
  <Border x:Name="HoverBridge" Grid.Row="1" Width="52" HorizontalAlignment="Right" Margin="10,0,10,10" Background="#01000000"/>
  <Border Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="12" Padding="8,5">
   <Button x:Name="Capsule" Width="34" Height="30" MinHeight="0" Padding="0" Margin="0" Focusable="False" Click="OnCapsule" ToolTip="Downloads · hover to reveal · click to keep open · drag the edge to move · right-click for options" AutomationProperties.Name="Downloads stack"><views:AppIcon Kind="Downloads" Width="23" Height="23"/></Button>
  </Border>
 </Grid>
</Window>
