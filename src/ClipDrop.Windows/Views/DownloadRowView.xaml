<UserControl x:Class="ClipDrop.Windows.Views.DownloadRowView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:views="clr-namespace:ClipDrop.Windows.Views" Focusable="False">
 <Grid ToolTip="{Binding Details}" Background="Transparent">
  <Grid.ColumnDefinitions><ColumnDefinition Width="{DynamicResource DownloadsPreviewSlot}"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
  <Border x:Name="HoverWash" Grid.ColumnSpan="4" Background="{DynamicResource Hover}" CornerRadius="4" Opacity="0" IsHitTestVisible="False"/>
  <Grid x:Name="PreviewGraphic" Width="{DynamicResource DownloadsPreviewSize}" Height="{DynamicResource DownloadsPreviewSize}" HorizontalAlignment="Left">
   <views:AppIcon Kind="{Binding RowItem.IconKey}" Width="{DynamicResource DownloadsPreviewSize}" Height="{DynamicResource DownloadsPreviewSize}">
    <views:AppIcon.Style><Style TargetType="views:AppIcon"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Source, ElementName=Thumbnail}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></views:AppIcon.Style>
   </views:AppIcon>
   <Image x:Name="Thumbnail" Stretch="Uniform" Visibility="{Binding RowItem.ImageVisible}"/>
  </Grid>
  <TextBlock Grid.Column="1" Text="{Binding File.Name}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12"/>
  <TextBlock x:Name="Timestamp" Grid.Column="2" Text="{Binding Time}" Visibility="{DynamicResource DownloadsTimeVisibility}" Foreground="{DynamicResource Muted}" FontSize="10" Width="43" TextAlignment="Right" VerticalAlignment="Center" Margin="4,0,0,0"/>
  <Button x:Name="FolderButton" Grid.Column="3" Width="{DynamicResource DownloadsActionSize}" Height="{DynamicResource DownloadsActionSize}" MinHeight="0" Padding="0" BorderThickness="0" BorderBrush="{DynamicResource Stroke}" Background="{DynamicResource Raised}" Margin="5,0,0,0" Tag="{DynamicResource DownloadsAlwaysShowFolder}" Click="OnFolder" ToolTip="{DynamicResource DownloadsFolderTooltip}" AutomationProperties.Name="Show in Explorer">
   <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
    <Setter Property="Opacity" Value="0"/><Setter Property="IsHitTestVisible" Value="False"/>
    <Style.Triggers>
     <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Opacity" Value="1"/><Setter Property="IsHitTestVisible" Value="True"/></DataTrigger>
     <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True"><Setter Property="Opacity" Value="1"/><Setter Property="IsHitTestVisible" Value="True"/></DataTrigger>
     <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Opacity" Value="1"/><Setter Property="IsHitTestVisible" Value="True"/></DataTrigger>
    </Style.Triggers>
   </Style></Button.Style>
   <views:AppIcon Kind="ShowFolder" Width="17" Height="17"/>
  </Button>
 </Grid>
</UserControl>
