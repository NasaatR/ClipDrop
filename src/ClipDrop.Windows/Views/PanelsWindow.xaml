<Window x:Class="ClipDrop.Windows.Views.PanelsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:ClipDrop.Windows.Views"
 Title="ClipDrop Saved panels" Width="420" Height="480" MinWidth="360" MinHeight="360" WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False" UseLayoutRounding="True" PreviewKeyDown="OnKey">
 <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" Padding="12">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Click="OnDismiss" ToolTip="Close manager" AutomationProperties.Name="Close panel manager"><views:AppIcon Kind="Close" Width="15" Height="15"/></Button><TextBlock Text="Saved panels" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
   <WrapPanel Grid.Row="1" Margin="0,8,0,6"><Button Content="New empty" Click="OnNew" AutomationProperties.Name="New empty panel"/><Button Content="Save dock" Click="OnSnapshot" ToolTip="Save the current dock as another panel" AutomationProperties.Name="Save current dock as panel"/><Button x:Name="SaveSelection" Content="Save selection" Click="OnSaveSelection" Visibility="Collapsed" AutomationProperties.Name="Save selection as panel"/></WrapPanel>
   <DockPanel Grid.Row="2" Margin="0,0,0,8"><Button x:Name="OpenFilter" Content="Saved" Click="OnOpenFilter"/><Button x:Name="ClosedFilter" Content="Recently closed" Click="OnClosedFilter"/><TextBlock x:Name="PanelCount" Foreground="{DynamicResource Muted}" FontSize="11" VerticalAlignment="Center" Margin="8,0,0,0"/></DockPanel>
   <Grid Grid.Row="3">
    <ListBox x:Name="PanelList" SelectionMode="Extended" SelectionChanged="OnSelection" MouseDoubleClick="OnDoubleClick" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" AutomationProperties.Name="Saved panel list">
     <ListBox.ItemTemplate><DataTemplate><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Details}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,0"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding ActiveLabel}" Foreground="{DynamicResource Muted}" FontSize="11" Margin="8,0,0,0" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate>
    </ListBox>
    <TextBlock x:Name="EmptyHint" Text="No recently closed panels" Foreground="{DynamicResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
   </Grid>
   <Grid Grid.Row="4" Margin="0,8,0,4"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="NameEditor" MaxLength="60" ToolTip="Name for renaming or combining panels" AutomationProperties.Name="Panel name" VerticalContentAlignment="Center"/><Button x:Name="RenameButton" Grid.Column="1" Content="Rename" Click="OnRename"/></Grid>
   <WrapPanel Grid.Row="5" Margin="0,4,0,4"><Button x:Name="OpenButton" Content="Use in dock" Click="OnOpen" ToolTip="Switch the main dock and its mirrors to this set"/><Button x:Name="WindowButton" Content="Open window" Click="OnWindow" ToolTip="Show this set in its own floating window" AutomationProperties.Name="Open independent panel window"/><Button x:Name="MergeButton" Content="Combine selected" Click="OnMerge" ToolTip="Create one panel from the selection; keep the source panels"/><Button x:Name="ClosePanelButton" Content="Close panel" Click="OnClosePanel" ToolTip="Keep clips in Library; reopen from Recently closed"/></WrapPanel>
   <TextBlock x:Name="Hint" Grid.Row="6" Text="Ctrl/Shift to select several · closing keeps your clips" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" Margin="2,4,2,0"/>
  </Grid>
 </Border>
</Window>
