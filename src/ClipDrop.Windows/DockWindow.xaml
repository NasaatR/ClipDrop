<Window x:Class="ClipDrop.Windows.DockWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ClipDrop Dock" SizeToContent="WidthAndHeight" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
 ShowInTaskbar="False" ShowActivated="False" Focusable="False" AllowDrop="True" UseLayoutRounding="True"
 DragOver="OnDragOver" Drop="OnDrop">
 <Window.Resources>
  <Style x:Key="DockButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Width" Value="{DynamicResource DockSize}"/><Setter Property="Height" Value="{DynamicResource DockSize}"/><Setter Property="MinHeight" Value="0"/>
   <Setter Property="Margin" Value="{DynamicResource DockGap}"/><Setter Property="Padding" Value="5"/><Setter Property="Focusable" Value="False"/>
  </Style>
 </Window.Resources>
 <Border x:Name="DockBody" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="{DynamicResource DockRadius}" Padding="8" ToolTipService.InitialShowDelay="600">
  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
   <Button x:Name="SaveButton" Style="{StaticResource DockButton}" Click="OnSave" ToolTip="Save clipboard" AutomationProperties.Name="Save clipboard" BorderThickness="1" BorderBrush="{DynamicResource Stroke}">
    <Path Style="{StaticResource LineIcon}" Data="{StaticResource SaveIcon}"/>
   </Button>
   <Border Width="1" Background="{DynamicResource Stroke}" Margin="5,5"/>
   <TextBlock x:Name="EmptyHint" Text="Drop here" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="8,0,10,0" FontSize="11" IsHitTestVisible="False"/>
   <ItemsControl x:Name="PinnedItems">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate>
     <Button Style="{StaticResource DockButton}" ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title}" Click="OnUseItem" PreviewMouseLeftButtonDown="OnItemDown" PreviewMouseLeftButtonUp="OnItemUp" PreviewMouseMove="OnItemMove" Loaded="OnPinLoaded">
      <Grid>
       <Image Width="{DynamicResource DockIconSize}" Height="{DynamicResource DockIconSize}" Stretch="Uniform" Visibility="{Binding ImageVisible}" Loaded="OnThumbnailLoaded"/>
       <TextBlock Text="{Binding DockGlyph}" Visibility="{Binding IconVisible}" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
     </Button>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
   <Button x:Name="OverflowButton" Style="{StaticResource DockButton}" Click="OnLibrary" ToolTip="More pinned items in Library" AutomationProperties.Name="Show more pinned items"/>
   <Button Style="{StaticResource DockButton}" Click="OnLibrary" ToolTip="Library · Ctrl+Alt+L" AutomationProperties.Name="Open Library"><Path Style="{StaticResource LineIcon}" Data="{StaticResource LibraryIcon}"/></Button>
   <Button Style="{StaticResource DockButton}" Click="OnSettings" ToolTip="Settings" AutomationProperties.Name="Settings"><Path Style="{StaticResource LineIcon}" Data="{StaticResource SettingsIcon}"/></Button>
   <Button Style="{StaticResource DockButton}" Click="OnHide" ToolTip="Hide dock · Ctrl+Alt+Space" AutomationProperties.Name="Hide dock"><Path Style="{StaticResource LineIcon}" Data="{StaticResource CloseIcon}" Stroke="{DynamicResource Muted}" Width="16" Height="16"/></Button>
  </StackPanel>
 </Border>
</Window>
