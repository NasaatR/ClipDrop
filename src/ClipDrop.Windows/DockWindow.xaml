<Window x:Class="ClipDrop.Windows.DockWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="ClipDrop Dock" SizeToContent="WidthAndHeight" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
 ShowInTaskbar="False" ShowActivated="False" Focusable="False" AllowDrop="True" UseLayoutRounding="True"
 DragOver="OnDragOver" Drop="OnDrop">
 <Window.Resources>
  <Style x:Key="DockButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Width" Value="{DynamicResource DockSize}"/><Setter Property="Height" Value="{DynamicResource DockSize}"/><Setter Property="MinHeight" Value="0"/>
   <Setter Property="Margin" Value="{DynamicResource DockGap}"/><Setter Property="Padding" Value="5"/><Setter Property="Focusable" Value="False"/>
  </Style>
 </Window.Resources>
 <Border x:Name="DockBody" BorderBrush="{DynamicResource Stroke}" BorderThickness="1" CornerRadius="{DynamicResource DockRadius}" Padding="6">
  <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
   <Border Width="16" Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="OnMove" ToolTip="Move dock" AutomationProperties.Name="Move dock">
    <Path Fill="{DynamicResource Muted}" Width="6" Height="18" Stretch="Uniform" Data="M0,0 H2 V2 H0 Z M4,0 H6 V2 H4 Z M0,6 H2 V8 H0 Z M4,6 H6 V8 H4 Z M0,12 H2 V14 H0 Z M4,12 H6 V14 H4 Z"/>
   </Border>
   <Button x:Name="SaveButton" Style="{StaticResource DockButton}" Width="76" Click="OnSave" ToolTip="Save clipboard to Library and pin to dock" AutomationProperties.Name="Save clipboard">
    <StackPanel Orientation="Horizontal"><Path Width="16" Height="16" Margin="0,0,7,0" Stretch="Uniform" Stroke="{DynamicResource Ink}" StrokeThickness="1.5" Data="M1,1 H12 L15,4 V15 H1 Z M4,1 V6 H11 V1 M4,15 V10 H12 V15"/><TextBlock Text="Save" FontSize="12" VerticalAlignment="Center"/></StackPanel>
   </Button>
   <Border Width="1" Background="{DynamicResource Stroke}" Margin="5,5"/>
   <TextBlock x:Name="EmptyHint" Text="Drop here" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" Margin="8,0,10,0" FontSize="11" IsHitTestVisible="False"/>
   <ItemsControl x:Name="PinnedItems">
    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
    <ItemsControl.ItemTemplate><DataTemplate>
     <Button Style="{StaticResource DockButton}" ToolTip="{Binding Title}" AutomationProperties.Name="{Binding Title}" Click="OnUseItem" PreviewMouseLeftButtonDown="OnItemDown" PreviewMouseLeftButtonUp="OnItemUp" PreviewMouseMove="OnItemMove">
      <Grid>
       <Image Width="{DynamicResource DockIconSize}" Height="{DynamicResource DockIconSize}" Stretch="Uniform" Visibility="{Binding ImageVisible}" Loaded="OnThumbnailLoaded"/>
       <TextBlock Text="{Binding DockGlyph}" Visibility="{Binding IconVisible}" FontSize="12" FontWeight="SemiBold" TextAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
     </Button>
    </DataTemplate></ItemsControl.ItemTemplate>
   </ItemsControl>
   <Button x:Name="OverflowButton" Style="{StaticResource DockButton}" Click="OnLibrary" ToolTip="More pinned items in Library" AutomationProperties.Name="Show more pinned items"/>
   <Button Style="{StaticResource DockButton}" Click="OnLibrary" ToolTip="Library · Ctrl+Alt+L" AutomationProperties.Name="Open Library"><Path Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource Ink}" StrokeThickness="1.6" Data="M2,3 H18 M2,10 H18 M2,17 H18"/></Button>
   <Button Style="{StaticResource DockButton}" Click="OnSettings" ToolTip="Settings" AutomationProperties.Name="Settings"><Path Width="17" Height="17" Stretch="Uniform" Stroke="{DynamicResource Ink}" StrokeThickness="1.5" Data="M1,3 H17 M1,9 H17 M1,15 H17 M5,0 V6 M12,6 V12 M7,12 V18"/></Button>
   <Button Style="{StaticResource DockButton}" Click="OnHide" ToolTip="Hide dock · Ctrl+Alt+Space" AutomationProperties.Name="Hide dock"><Path Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource Muted}" StrokeThickness="1.5" Data="M1,1 L11,11 M11,1 L1,11"/></Button>
  </StackPanel>
 </Border>
</Window>
