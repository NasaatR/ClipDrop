{
  "manifest_version": 3,
  "name": "ClipDrop Downloads",
  "version": "0.14.0",
  "minimum_chrome_version": "120",
  "description": "Recent Chrome downloads in the ClipDrop floating shelf, wherever you save them.",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage",
    "alarms"
  ],
  "incognito": "not_allowed",
  "key": "",
  "background": {
    "service_worker": "worker.mjs",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ClipDrop Downloads"
  }
}
